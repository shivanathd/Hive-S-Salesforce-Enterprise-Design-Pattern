<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Environment__c</fullName>
    <label>Environment</label>
    <description>Limits the record to one kind of org. A record for the current environment wins over a record with no environment.</description>
    <inlineHelpText>Leave blank to apply everywhere.</inlineHelpText>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>PRODUCTION</fullName>
                <default>false</default>
                <label>Production org</label>
            </value>
            <value>
                <fullName>SANDBOX</fullName>
                <default>false</default>
                <label>Sandbox</label>
            </value>
            <value>
                <fullName>SCRATCH</fullName>
                <default>false</default>
                <label>Scratch or trial org</label>
            </value>
        </valueSetDefinition>
    </valueSet>
    <required>false</required>
</CustomField>
